<?xml version="1.0" encoding="utf-8"?>
<!--
  ~ Oxide Launcher launcher icon monochrome (themed icons).
  ~
  ~ This must be the silhouette of the adaptive foreground in
  ~ res/mipmap-<density>/ic_launcher_foreground.png. The foreground is the
  ~ supplied icon.png artwork composited over its own plate colour, so the
  ~ silhouette is the artwork's rounded-square tile, and that is what is drawn
  ~ here - a filled plate, not an outline.
  ~
  ~ Measured off the artwork (1254 px canvas) and converted to the 108 dp
  ~ adaptive viewport, which covers the 1085 px square centred on the tile:
  ~   tile   x 75..1176, y 75..1141   ->  -0.80..108.79 dp, 0.90..107.09 dp
  ~   corner radius 237 px            ->  23.59 dp
  ~
  ~ The tile is deliberately wider than the 108 dp viewport: at 109.6 dp it
  ~ covers the whole 72 dp mask on every launcher mask shape, so no plate
  ~ colour ever shows at the edge.
  ~
  ~ No android:tint: the launcher supplies the themed-icon colour, and a tint
  ~ here would multiply against it.
  -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:pathData="M22.79,0.9 H85.2 A23.59,23.59 0 0 1 108.79,24.49 V83.5 A23.59,23.59 0 0 1 85.2,107.09 H22.79 A23.59,23.59 0 0 1 -0.8,83.5 V24.49 A23.59,23.59 0 0 1 22.79,0.9 Z"
        android:fillColor="#FFFFFFFF" />
</vector>