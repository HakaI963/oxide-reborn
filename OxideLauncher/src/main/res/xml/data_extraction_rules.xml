<?xml version="1.0" encoding="utf-8"?><!--
   Data extraction rules (Android 12+).

   `launcher_data.db` stores account credentials: the Microsoft access token, the renewable
   Microsoft refresh token and the plaintext password of any third-party (authlib-injector)
   account. They are excluded from both cloud backup and device-to-device transfer so the
   tokens cannot be recovered from a backup or a device migration.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude
            domain="database"
            path="launcher_data.db" />
        <exclude
            domain="file"
            path="settings.json" />
    </cloud-backup>
    <device-transfer>
        <exclude
            domain="database"
            path="launcher_data.db" />
        <exclude
            domain="file"
            path="settings.json" />
    </device-transfer>
</data-extraction-rules>